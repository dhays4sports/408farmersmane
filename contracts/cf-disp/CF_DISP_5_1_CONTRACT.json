{
  "schemaVersion": "1.0",
  "program": "CF-DISP",
  "sprint": "CF-DISP-5.1",
  "title": "Accessibility, Performance, Privacy + Security Certification",
  "baselineVersion": "3.20.200",
  "releaseOverlay": "CF-DISP-5.2",
  "purpose": "Certifies mobile-first source behavior, semantic controls, reduced motion, bounded/sanitized inputs, PII separation, and protected consent semantics.",
  "implementationFiles": [
    "assets/css/displacement.css",
